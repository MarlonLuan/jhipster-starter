{
  "name": "jhipster",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "Description for JHipster",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run webapp:prod --",
    "build-watch": "concurrently 'npm run webapp:build:dev -- --watch'",
    "ci:frontend:build": "npm run webapp:build:$npm_package_config_default_environment",
    "ci:frontend:test": "npm run ci:frontend:build && npm test",
    "clean-www": "rimraf target/classes/static/",
    "cleanup": "rimraf target/",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "prettier:check": "prettier --check \"{,.blueprint/**/,src/**/,build-plugins/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,html,css,scss,java}\"",
    "prettier:format": "prettier --write \"{,.blueprint/**/,src/**/,build-plugins/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,html,css,scss,java}\"",
    "serve": "npm run start --",
    "sonar": "sonar-scanner",
    "start": "ng serve --hmr",
    "start-tls": "npm run webapp:dev-ssl",
    "pretest": "npm run lint",
    "test": "ng test --coverage",
    "test:watch": "npm run test -- --watch",
    "watch": "concurrently npm:start",
    "webapp:build": "npm run clean-www && npm run webapp:build:dev",
    "webapp:build:dev": "ng build --configuration development",
    "webapp:build:prod": "ng build --configuration production",
    "webapp:dev": "ng serve",
    "webapp:dev-ssl": "ng serve --ssl",
    "webapp:dev-verbose": "ng serve --verbose",
    "webapp:prod": "npm run clean-www && npm run webapp:build:prod",
    "webapp:test": "npm run test --"
  },
  "config": {
    "default_environment": "prod"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/localize": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fortawesome/angular-fontawesome": "5.1.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@ngx-translate/core": "18.1.0",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.23",
    "ngx-infinite-scroll": "22.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "22.0.1",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/service-worker": "22.2.5",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/folder-hash": "4.0.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "angular-eslint": "22.6.0",
    "axios": "1.21.1",
    "concurrently": "10.0.7",
    "deepmerge": "4.3.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "folder-hash": "4.1.4",
    "generator-jhipster": "9.4.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.1.0",
    "rimraf": "6.1.4",
    "sonar-scanner": "3.1.0",
    "swagger-ui-dist": "5.34.1",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.5.1"
  },
  "engines": {
    "node": ">=24.22.3"
  }
}
